# Copy this file to .env.local and fill in your values.
# Get your client ID from https://developer.spotify.com/dashboard
#
# After creating the app in the Spotify dashboard, add these redirect URIs:
#   - exp://localhost:8081  (Expo Go on simulator)
#   - exp://192.168.x.x:8081  (Expo Go on a physical device — use your machine's LAN IP)
#   - radii://  (production / standalone build)
#
# Required scopes: user-read-currently-playing, user-read-playback-state

EXPO_PUBLIC_SPOTIFY_CLIENT_ID=your_spotify_client_id_here

# Radii backend URL.
# iOS simulator can use localhost. Physical devices need your Mac's LAN IP:
#   EXPO_PUBLIC_SERVER_URL=http://192.168.x.x:3000
EXPO_PUBLIC_SERVER_URL=http://localhost:3000
